 <!DOCTYPE html>
 <html>
 <head>
  <title>Note Taking Extension</title>
  <link rel="stylesheet" href="style.css">
 </head>
 <body>
  <div class="container">
  <h1>Note Taking Extension</h1>
  <textarea id="note-text" placeholder="Enter your note here..."></textarea>
  <div class="controls">
  <button id="save-note">Save Note</button>
  <button id="clear-note">Clear Note</button>
  </div>
  <h2>Saved Notes</h2>
  <ul id="note-list">
  <!-- Notes will be dynamically added here -->
  </ul>
  </div>
  <script src="script.js"></script>
 </body>
 </html>
 
